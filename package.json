{
  "name": "inkspace",
  "version": "0.7.3",
  "private": true,
  "scripts": {
    "build:theia": "npm run build && node theia/build-media.cjs && node theia/prepare-native.cjs && npm run build --prefix theia",
    "start:theia": "node theia/host.cjs",
    "test:theia": "node theia/host.cjs --smoke-test",
    "build:vscode": "npm run build && node scripts/build-vscode.cjs",
    "build:vscodium-native": "npm run build:vscode && node scripts/build-vscodium-native.cjs",
    "dist:vscodium": "npm run build:vscode && node scripts/package-vscodium-installer.cjs",
    "test:installer:vscodium": "node scripts/verify-vscodium-installer.cjs",
    "test:vscode": "node scripts/test-vscode.cjs",
    "build": "node scripts/build.cjs",
    "test": "node tests/core.cjs && node tests/rendering.cjs && node tests/low-zoom.cjs && node tests/folder-files.cjs && node tests/native-frame-geometry.cjs && node tests/explorer-operations.cjs && node tests/binary-notebook.cjs && node tests/autosave.cjs && node tests/recovery.cjs && node tests/navigation.cjs",
    "start": "electron .",
    "test:desktop": "electron . --smoke-test",
    "dist": "npm run build:native && npm run build:terminal && npm run build && electron-builder --win nsis --x64 && node scripts/package-source.cjs",
    "test:package": "node scripts/verify-package.cjs",
    "test:text:mouse": "electron tests/text-mouse-electron.cjs",
    "test:raster": "electron tests/raster-electron.cjs",
    "build:native": "node scripts/build-native.cjs",
    "test:native": "node tests/native-ink.cjs",
    "build:terminal": "node scripts/build-terminal.cjs",
    "test:folder-launch": "node tests/folder-launch.cjs",
    "build:engine": "node scripts/build-raw-input-probe.cjs && node scripts/build-vscode.cjs",
    "start:engine": "node ink-engine/service.cjs",
    "start:engine:vscode": "node scripts/start-ink-engine-validation.cjs",
    "test:engine": "node tests/engine-calibration.cjs && node tests/engine-calibration-persistence.cjs && node tests/engine-lifecycle.cjs && node scripts/test-ink-engine.cjs",
    "dist:vscode": "node scripts/build-vscode.cjs && node scripts/package-vscode-engine.cjs",
    "dist:vscode:bundle": "node scripts/package-vscode-bundle.cjs",
    "test:engine:binary": "node -e \"process.env.INKSPACE_ENGINE_BINARY_TEST='1';require('./scripts/test-ink-engine.cjs')\"",
    "test:navigation": "node tests/navigation.cjs && electron tests/navigation-electron.cjs",
    "test:interaction": "electron tests/interaction-electron.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "fs-extra": "^11.4.1",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "monaco-editor": "^0.57.0",
    "mxgraph": "4.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.inkspace.notes",
    "productName": "墨境",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "renderer.js",
      "pdf.js",
      "desktop/**",
      "vendor/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Inkspace-${version}-Setup.exe",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "asarUnpack": [
      "desktop/native/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "desktop/installer.nsh",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true
    }
  },
  "description": "Windows infinite handwriting canvas with Markdown, equations and selectable PDF annotations",
  "author": "Inkspace",
  "license": "GPL-3.0-or-later"
}
