{
  "name": "inkspace",
  "displayName": "墨境 Inkspace",
  "description": "Infinite pen notebooks with independent Raw Input and Cairo engine for VS Code",
  "version": "0.11.0",
  "publisher": "nollasalt",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/nollasalt/inkspace.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "inkspace.notebook",
        "displayName": "墨境笔记",
        "selector": [
          {
            "filenamePattern": "*.inkspace.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "inkspace.binary",
        "displayName": "墨境二进制笔记",
        "selector": [
          {
            "filenamePattern": "*.ink"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "inkspace.new",
        "title": "新建笔记",
        "category": "墨境"
      },
      {
        "command": "inkspace.open",
        "title": "用墨境打开笔记",
        "category": "墨境"
      },
      {
        "command": "inkspace.copy",
        "title": "复制选中内容",
        "category": "墨境"
      },
      {
        "command": "inkspace.paste",
        "title": "粘贴到画布",
        "category": "墨境"
      },
      {
        "command": "inkspace.undo",
        "title": "撤销笔记操作",
        "category": "墨境"
      },
      {
        "command": "inkspace.redo",
        "title": "重做笔记操作",
        "category": "墨境"
      },
      {
        "command": "inkspace.save",
        "title": "保存当前笔记",
        "category": "墨境"
      },
      {
        "command": "inkspace.showPages",
        "title": "显示笔记画布",
        "category": "墨境"
      },
      {
        "command": "inkspace.addPage",
        "title": "添加画布",
        "category": "墨境",
        "icon": "$(add)"
      },
      {
        "command": "inkspace.renamePage",
        "title": "重命名画布",
        "category": "墨境",
        "icon": "$(edit)"
      },
      {
        "command": "inkspace.deletePage",
        "title": "删除画布",
        "category": "墨境",
        "icon": "$(trash)"
      },
      {
        "command": "inkspace.switchPage",
        "title": "切换画布",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.pen",
        "title": "切换画笔",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.erase",
        "title": "切换橡皮擦",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.text",
        "title": "切换文本",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.select",
        "title": "切换内容编排",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.shape",
        "title": "切换图形",
        "category": "墨境"
      },
      {
        "command": "inkspace.tool.diagram",
        "title": "打开 / 收起图形库",
        "category": "墨境"
      },
      {
        "command": "inkspace.showDiagnostics",
        "title": "查看性能与保存诊断",
        "category": "墨境"
      },
      {
        "command": "inkspace.saveRecoveryCopy",
        "title": "保存当前画布的恢复副本",
        "category": "墨境"
      },
      {
        "command": "inkspace.find",
        "title": "搜索当前笔记",
        "category": "墨境",
        "icon": "$(search)"
      },
      {
        "command": "inkspace.navigateBack",
        "title": "返回上一位置",
        "category": "墨境",
        "icon": "$(arrow-left)"
      },
      {
        "command": "inkspace.navigateForward",
        "title": "前进到下一位置",
        "category": "墨境",
        "icon": "$(arrow-right)"
      },
      {
        "command": "inkspace.movePageUp",
        "title": "上移画布",
        "category": "墨境",
        "icon": "$(arrow-up)"
      },
      {
        "command": "inkspace.movePageDown",
        "title": "下移画布",
        "category": "墨境",
        "icon": "$(arrow-down)"
      },
      {
        "command": "inkspace.tool.pan",
        "title": "触控笔移动画布",
        "category": "墨境"
      },
      {
        "command": "inkspace.group",
        "title": "组合选中的块",
        "category": "墨境"
      },
      {
        "command": "inkspace.ungroup",
        "title": "取消块组合",
        "category": "墨境"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inkspace",
          "title": "墨境",
          "icon": "page.svg"
        }
      ]
    },
    "views": {
      "inkspace": [
        {
          "id": "inkspace.pages",
          "name": "画布",
          "when": "inkspace.hasNotebook"
        }
      ]
    },
    "viewsWelcome": [],
    "menus": {
      "explorer/context": [
        {
          "command": "inkspace.new",
          "when": "explorerViewletVisible && resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "inkspace.open",
          "when": "resourceExtname == .json || resourceExtname == .ink",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "inkspace.addPage",
          "when": "view == inkspace.pages && inkspace.hasNotebook",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "inkspace.renamePage",
          "when": "view == inkspace.pages",
          "group": "1_canvas"
        },
        {
          "command": "inkspace.deletePage",
          "when": "view == inkspace.pages && viewItem != inkspace.pageOnly",
          "group": "1_canvas"
        },
        {
          "command": "inkspace.movePageUp",
          "when": "view == inkspace.pages && viewItem != inkspace.pageFirst && viewItem != inkspace.pageOnly",
          "group": "2_order"
        },
        {
          "command": "inkspace.movePageDown",
          "when": "view == inkspace.pages && viewItem != inkspace.pageLast && viewItem != inkspace.pageOnly",
          "group": "2_order"
        }
      ],
      "commandPalette": [
        {
          "command": "inkspace.showPages",
          "when": "inkspace.hasNotebook"
        },
        {
          "command": "inkspace.addPage",
          "when": "inkspace.hasNotebook"
        },
        {
          "command": "inkspace.renamePage",
          "when": "false"
        },
        {
          "command": "inkspace.deletePage",
          "when": "false"
        },
        {
          "command": "inkspace.switchPage",
          "when": "false"
        },
        {
          "command": "inkspace.movePageUp",
          "when": "false"
        },
        {
          "command": "inkspace.movePageDown",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "inkspace.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.redo",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.pen",
        "key": "p",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.erase",
        "key": "e",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.text",
        "key": "t",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.select",
        "key": "v",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.shape",
        "key": "s",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.diagram",
        "key": "d",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.undo",
        "key": "ctrl+z",
        "when": "inkspace.hasNotebook && inkspace.inlineTextFocused && !terminalFocus"
      },
      {
        "command": "inkspace.redo",
        "key": "ctrl+shift+z",
        "when": "inkspace.hasNotebook && inkspace.inlineTextFocused && !terminalFocus"
      },
      {
        "command": "inkspace.redo",
        "key": "ctrl+y",
        "when": "inkspace.hasNotebook && inkspace.inlineTextFocused && !terminalFocus"
      },
      {
        "command": "inkspace.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.navigateBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.navigateForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "(activeCustomEditorId == inkspace.notebook || activeCustomEditorId == inkspace.binary) && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.tool.pan",
        "key": "h",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.group",
        "key": "ctrl+g",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      },
      {
        "command": "inkspace.ungroup",
        "key": "ctrl+shift+g",
        "when": "inkspace.hasNotebook && !inputFocus && !terminalFocus && !inkspace.canvasKeyboardFocused"
      }
    ],
    "configuration": {
      "title": "Inkspace",
      "properties": {
        "inkspace.autoSaveDelay": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 60000,
          "description": "停止修改后合并保存的延迟（毫秒）。Ctrl+S、切换笔记时立即保存；VS Code 自身自动保存也可以提前保存。重新打开笔记后生效。"
        },
        "inkspace.autoSaveMaxDelay": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "连续编辑时两次合并保存之间的最大等待（毫秒），不小于停止修改后的保存延迟。重新打开笔记后生效。"
        }
      }
    }
  }
}
