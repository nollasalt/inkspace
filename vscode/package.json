{
  "name": "inkspace",
  "displayName": "墨境 Inkspace",
  "description": "Infinite pen notebooks, Markdown objects and PDF annotations for VSCodium",
  "version": "0.2.2",
  "publisher": "nollasalt",
  "license": "GPL-2.0-or-later",
  "repository": {"type": "git", "url": "https://github.com/nollasalt/inkspace.git"},
  "engines": {"vscode": "^1.90.0"},
  "categories": ["Other"],
  "main": "./extension.cjs",
  "extensionKind": ["ui"],
  "capabilities": {"untrustedWorkspaces": {"supported": true}, "virtualWorkspaces": {"supported": true}},
  "contributes": {
    "customEditors": [{"viewType": "inkspace.notebook", "displayName": "墨境笔记", "selector": [{"filenamePattern": "*.inkspace.json"}], "priority": "default"}],
    "commands": [
      {"command": "inkspace.new", "title": "新建笔记", "category": "墨境"},
      {"command": "inkspace.open", "title": "用墨境打开笔记", "category": "墨境"},
      {"command": "inkspace.save", "title": "保存当前笔记", "category": "墨境"},
      {"command": "inkspace.showPages", "title": "显示笔记页面", "category": "墨境"},
      {"command": "inkspace.addPage", "title": "添加页面", "category": "墨境", "icon": "$(add)"},
      {"command": "inkspace.renamePage", "title": "重命名页面", "category": "墨境", "icon": "$(edit)"},
      {"command": "inkspace.deletePage", "title": "删除页面", "category": "墨境", "icon": "$(trash)"},
      {"command": "inkspace.switchPage", "title": "切换页面", "category": "墨境"}
    ],
    "viewsContainers": {"activitybar": [{"id": "inkspace", "title": "墨境页面", "icon": "page.svg"}]},
    "views": {"inkspace": [{"id": "inkspace.pages", "name": "笔记页面", "when": "inkspace.hasNotebook"}]},
    "viewsWelcome": [{"view": "inkspace.pages", "contents": "打开 .inkspace.json 笔记即可切换页面。\n[新建笔记](command:inkspace.new)"}],
    "menus": {
      "explorer/context": [{"command": "inkspace.open", "when": "resourceExtname == .json", "group": "navigation"}],
      "view/title": [{"command": "inkspace.addPage", "when": "view == inkspace.pages && inkspace.hasNotebook", "group": "navigation"}],
      "view/item/context": [
        {"command": "inkspace.renamePage", "when": "view == inkspace.pages && viewItem == inkspace.page", "group": "inline"},
        {"command": "inkspace.deletePage", "when": "view == inkspace.pages && viewItem == inkspace.page", "group": "navigation"}
      ]
    },
    "keybindings": [{"command": "inkspace.save", "key": "ctrl+s", "mac": "cmd+s", "when": "activeCustomEditorId == inkspace.notebook && !inputFocus"}]
  }
}
