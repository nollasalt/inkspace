{
  "type": "object",
  "additionalProperties": false,
  "required": ["markdown", "nodes", "edges", "uncertainties"],
  "properties": {
    "markdown": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "content", "bounds"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["text", "math"] },
          "content": { "type": "string" },
          "bounds": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "label", "relation"],
        "properties": {
          "from": { "type": "string" }, "to": { "type": "string" },
          "label": { "type": "string" },
          "relation": { "type": "string", "enum": ["branch", "arrow", "association", "unknown"] }
        }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  }
}
